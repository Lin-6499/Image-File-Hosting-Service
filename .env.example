# ---- server ----
DEBUG=true
HOST=127.0.0.1
PORT=8000
BASE_URL=http://127.0.0.1:8000

# ---- signing ----
# Production MUST set this to a stable random value, otherwise every deploy
# silently breaks live links.
#
# In development both choices are defensible, and the trade-off is real:
#   - Empty  -> a random key per boot. Links die on restart, which is a safe
#               failure mode, but the autoreloader restarts on every save, so
#               any link you just generated dies the moment you edit a file.
#   - Set    -> links survive restarts. Recommended while doing manual testing
#               through /docs or api.http, where a surprise 403 is otherwise
#               indistinguishable from a real signing bug.
# Generate with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ---- storage ----
MAX_FILE_SIZE=104857600
MAX_TTL=604800
DEFAULT_TTL=3600
CLOCK_SKEW=5

# SQLite journal mode.
# TRUNCATE (default) - portable; required on Windows volumes that cannot host
#                      WAL's shared-memory (-shm) file. On such a volume WAL
#                      makes the process hang at startup with no error output.
# WAL                - preferred on Linux production servers: readers never
#                      block the writer. Switch to this after deploying.
DB_JOURNAL_MODE=TRUNCATE

# ---- images ----
THUMB_SIZE=512
THUMB_QUALITY=82

# ---- limits ----
RATE_LIMIT_PER_MIN=300
DISK_HIGH_WATERMARK=0.90

# ---- antivirus (optional) ----
# none      - scanning off; uploads recorded as 'skipped' (default)
# clamd     - talk to a running clamd daemon over TCP/unix socket (production)
# clamscan  - shell out to the clamscan binary per file (low volume only)
# stub      - TESTS/DRY RUNS ONLY. Provides no real protection.
AV_BACKEND=none
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
# Set to override host/port, e.g. /var/run/clamav/clamd.ctl
CLAMD_SOCKET=
CLAMSCAN_PATH=clamscan
AV_TIMEOUT=30.0
# Files left 'pending' longer than this are marked 'error' by the sweeper, so
# a dead scanner cannot leave uploads permanently unservable.
AV_PENDING_GRACE=900
# Only used when AV_BACKEND=stub: comma-separated content
# substrings reported as infected. Lets you exercise the full upload ->
# scan -> gate path locally without ClamAV installed.
AV_STUB_MARKERS=MALWARE_MARKER

# ---- serving ----
# true  = FastAPI streams files (Windows local dev, no nginx)
# false = emit X-Accel-Redirect and let nginx serve (Linux production)
SERVE_FILES_DIRECTLY=true
